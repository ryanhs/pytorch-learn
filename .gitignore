# =====================================================================
# Git Ignore for PyTorch & Deep Learning Workspace
# =====================================================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# PyTorch checkpoints and large model weights (regenerated via training)
*.pt
*.pth
*.pwf
*.bin
*.onnx
*.engine
*.safetensors
*.ckpt
**/weights/

# Datasets (downloaded automatically at runtime)
**/data/
**/datasets/
*.tar.gz
*.tar
*.zip
*.gz

# Training artifacts, experiment runs, and logs
**/runs/
**/train_output/
**/scratch_demo_output/
**/compare_output/
**/output/
*.log

# Generated output plots / visual results
**/docker_data/*.png

# Archived study checkpoints & visual results (whitelisted special cases)
!test2/docker_data/cifar10_cnn.pt
!test2/docker_data/comparison_before_after.png
!test2/docker_data/training_curves.png

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

